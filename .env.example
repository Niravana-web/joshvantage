# Copy to .env.local and fill in
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGODB_DB=joshvantage

# Password for /admin (HTTP Basic auth; any username)
ADMIN_PASSWORD=
RESEND_API_KEY=

# Google Search Console verification token (the content value of the
# google-site-verification meta tag). Must be set at build time.
GOOGLE_SITE_VERIFICATION=
